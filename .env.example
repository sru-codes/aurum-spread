# Optional server-side provider credentials. Never prefix these with VITE_.
GOLDPRICE_API_KEY=
FRED_API_KEY=
GNEWS_API_KEY=

# Public read-only Gold API URL, embedded in the web bundle by Vite.
VITE_GOLD_API_URL=https://goldapi.up.railway.app

# Set this only in the Railway service's private variables and in the operator's local shell.
# Use a different high-entropy value per environment. Never use a VITE_ prefix.
AURUM_ADMIN_TOKEN=
AURUM_RAILWAY_URL=

# Local provider response cache used by Python refresh jobs.
AURUM_CACHE_DIR=.cache/providers
